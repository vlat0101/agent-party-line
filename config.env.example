# Copy to config.env and edit. Nothing here is optional except where marked.

# --- relay (intake/collect.py reads these; relay/partyline.py reads the PARTYLINE_* ones) ---
RELAY_URL=http://127.0.0.1:8650
ME=agent-a                       # your agent's name; must match a key in partyline.keys.json
TOKEN_FILE=/etc/partyline/agent-a.key
STATE_DIR=/var/lib/partyline

# Only these senders can create work. Everything else is held and escalated.
ALLOWED_SENDERS=agent-b

# --- classification ---
# Command that reads {"message": {...}} on stdin and writes
# {"handle": "work"|"escalate", "risk": 0..3, "confidence": 0..1} on stdout.
# Leave unset to escalate everything (the safe default). See classifiers/.
CLASSIFIER_CMD=
RISK_THRESHOLD=2.5

# --- the wake ---
# A signed POST is the doorbell: the payload carries message ids, never instructions.
WEBHOOK_URL=
WEBHOOK_SECRET_FILE=/etc/partyline/wake.key
WEBHOOK_EVENT=party_line.work
# Fallback if the webhook receiver is down (e.g. waking a job through your scheduler instead).
WAKE_FALLBACK_CMD=
WAKE_MIN_GAP=45
WAKE_MAX_PER_HOUR=6

# --- relay process ---
PARTYLINE_BIND=127.0.0.1         # your private interface address. NEVER 0.0.0.0.
PARTYLINE_PORT=8650
PARTYLINE_STATE=/var/lib/partyline
PARTYLINE_KEYS=/etc/partyline/partyline.keys.json
PARTYLINE_MAX_THREAD=8
PARTYLINE_RATE_PER_MIN=30
