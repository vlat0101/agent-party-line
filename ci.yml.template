name: ci

on:
  push:
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Behaviour tests
        run: python -m unittest discover -s tests -p "test_*.py" -v
      - name: Leak scan
        run: bash scripts/leak-scan.sh
